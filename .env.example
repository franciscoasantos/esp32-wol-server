# JWT Secret (use uma string aleatória segura)
JWT_SECRET=SUA_CHAVE_SECRETA_AQUI

# HMAC Secret (deve ser igual ao SECRET definido no config.h do ESP32)
HMAC_SECRET=SUA_CHAVE_HMAC_AQUI

# Credenciais de login
LOGIN_USER=admin
LOGIN_PASS=SUA_SENHA_AQUI

# Portas
TUNNEL_PORT=9001
HTTP_PORT=9000

# Coordenadas para rotinas de nascer/pôr do sol (opcional).
# Sem elas, só gatilhos de horário fixo funcionam.
LATITUDE=-23.5505
LONGITUDE=-46.6333

# Base pública para o OTA. É a URL que o ESP32 usa para baixar o firmware,
# então precisa ser alcançável de fora — a mesma que atende o wss:// do túnel.
# Sem ela o botão de atualizar fica indisponível.
PUBLIC_BASE_URL=https://wol.exemplo.net
